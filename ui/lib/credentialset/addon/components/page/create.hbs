<PageHeader as |p|>
  <p.top>
    <Page::Breadcrumbs @breadcrumbs={{@breadcrumbs}} />
  </p.top>
  <p.levelLeft>
    <h1 class="title is-3">Create credential set</h1>
  </p.levelLeft>
</PageHeader>

<hr class="is-marginless has-background-gray-200" />

<p class="has-top-margin-m">
  A credential set serves one logical credential out of N slots that are rotated in turn. When the active slot changes,
  the previous credential stays valid for the overlap period so that consumers (for example External Secrets Operator)
  have time to pick up the new one. A set cannot be changed after creation.
</p>

<form id="credential-set" class="has-top-margin-l" {{on "submit" (perform this.save)}} data-test-credential-set-form>
  {{#if this.error}}
    <MessageError @errorMessage={{this.error}} class="has-bottom-margin-s" />
  {{/if}}

  <div class="field">
    <label class="is-label" for="cs-name">Name</label>
    <input id="cs-name" class="input" type="text" value={{this.name}} {{on "input" (fn this.update "name")}} data-test-input="name" />
  </div>

  <div class="field">
    <label class="is-label" for="cs-slots">Slots</label>
    <p class="has-text-grey is-size-8">Comma separated slot names, at least two. A slot name is the username of its credential.</p>
    <input id="cs-slots" class="input" type="text" placeholder="app_a,app_b" value={{this.slots}} {{on "input" (fn this.update "slots")}} data-test-input="slots" />
    <p class="has-text-grey is-size-8">{{this.hint}}</p>
  </div>

  <div class="field">
    <label class="is-label" for="cs-validity">Validity</label>
    <p class="has-text-grey is-size-8">How long one credential lives, for example 30d, 12h or 3m.</p>
    <input id="cs-validity" class="input" type="text" value={{this.validity}} {{on "input" (fn this.update "validity")}} data-test-input="validity" />
  </div>

  <div class="field">
    <label class="is-label" for="cs-overlap">Overlap</label>
    <p class="has-text-grey is-size-8">How long the previous credential stays valid after the switch. Longer overlap gives consumers more time to refresh but widens the window after a leak.</p>
    <input id="cs-overlap" class="input" type="text" value={{this.overlap}} {{on "input" (fn this.update "overlap")}} data-test-input="overlap" />
  </div>

  <div class="field">
    <label class="is-label" for="cs-lead">Prepare lead (optional)</label>
    <p class="has-text-grey is-size-8">Create the next credential this long before the switch. Must be shorter than the active time.</p>
    <input id="cs-lead" class="input" type="text" value={{this.prepareLead}} {{on "input" (fn this.update "prepareLead")}} data-test-input="prepare_lead" />
  </div>

  <div class="field">
    <label class="is-label" for="cs-anchor">Anchor (optional)</label>
    <p class="has-text-grey is-size-8">RFC 3339 time of the first activation. Defaults to now.</p>
    <input id="cs-anchor" class="input" type="text" placeholder="2026-01-01T00:00:00Z" value={{this.anchor}} {{on "input" (fn this.update "anchor")}} data-test-input="anchor" />
  </div>

  <div class="field">
    <label class="is-label" for="cs-pwlen">Password length</label>
    <input id="cs-pwlen" class="input" type="number" min="16" max="256" value={{this.passwordLength}} {{on "input" (fn this.update "passwordLength")}} data-test-input="password_length" />
  </div>
</form>

<hr class="is-marginless has-background-gray-200" />

<div class="has-top-margin-l has-bottom-margin-s">
  <button type="submit" form="credential-set" class="button is-primary {{if this.save.isRunning 'is-loading'}}" disabled={{this.save.isRunning}} data-test-save>
    Save
  </button>
  <button type="button" class="button has-left-margin-s" {{on "click" this.cancel}} data-test-cancel>
    Back
  </button>
</div>
